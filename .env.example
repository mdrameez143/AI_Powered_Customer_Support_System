# Choose "groq" (free-tier API, needs a key) or "ollama" (fully local, no key)
LLM_PROVIDER=groq

# --- Groq (https://console.groq.com/keys — free) ---
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# --- Ollama (https://ollama.com — run `ollama serve` and `ollama pull llama3.1`) ---
# Running the API directly with uvicorn (not Docker): use http://localhost:11434
# Running the API via docker-compose: use http://host.docker.internal:11434
# instead — inside the container, "localhost" means the container itself, not
# your machine. docker-compose.yml already maps that hostname for you.
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1

# Path to the ticket CSV (defaults to app/data/support_tickets.csv)
TICKETS_CSV_PATH=

# Where the Streamlit UI finds the API
API_BASE_URL=http://localhost:8000
